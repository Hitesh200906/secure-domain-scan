# Copy to .env locally, and configure these in Vercel → Project Settings → Environment Variables.
# All variables must be set for BOTH "Production" and "Preview" environments on Vercel.

# --- Client-side (bundled into the browser by Vite) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT

# --- Server-side (read by server functions / SSR at runtime) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_PROJECT_ID=YOUR-PROJECT

# Server-only — NEVER prefix with VITE_. Required for admin/server-fn operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — only needed if you use Lovable AI features from server code.
# LOVABLE_API_KEY=your-lovable-api-key
