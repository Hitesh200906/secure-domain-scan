# Render / local environment for the Express backend.
# Copy to server/.env locally; configure these in Render → Environment.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=replace-with-a-long-random-string

# Google OAuth (Web client). Authorized redirect URI:
#   https://YOUR-RENDER-URL.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend (Vercel) URL — used for CORS + OAuth redirects.
FRONTEND_URL=https://your-app.vercel.app

PORT=8080
NODE_ENV=production
